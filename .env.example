# Copy to .env and adjust; docker compose reads it automatically.

# Deliver through your own webhook.site URL instead of the bundled mock provider.
# On webhook.site (Edit) set: status code 202, content type application/json and a
# response body such as {"messageId":"wh-1","status":"accepted","timestamp":"2026-01-01T00:00:00Z"}
# PROVIDER_URL=https://webhook.site/00000000-0000-0000-0000-000000000000

# Mock provider behaviour (ignored when PROVIDER_URL points elsewhere)
MOCK_FAILURE_RATE=0.1
MOCK_THROTTLE_RATE=0.0

RATE_LIMIT_PER_SECOND=100
MAX_ATTEMPTS=5
LOG_LEVEL=info
